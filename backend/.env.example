# === App ===
APP_ENV=development
LOG_LEVEL=INFO

# === Agent Maestro (LLM gateway, required) ===
# Maestro is an Anthropic-API-compatible gateway proxying Claude / GPT / Gemini.
# All LLM traffic in Plus One goes through it. Token-unlimited internally.
MAESTRO_BASE_URL=http://host.docker.internal:23333/api/anthropic
MAESTRO_AUTH_TOKEN=Powered by Agent Maestro

# === Per-role model overrides (defaults work; override to experiment) ===
# Producer / Joiner — heavy reasoning, Claude Opus 4.7
MODEL_PRODUCER_AGENT=claude-opus-4.7
MODEL_JOINER_AGENT=claude-opus-4.7

# Controller / Skill router / Conversational — cheap + fast, Claude Haiku 4.5
MODEL_CONTROLLER_AGENT=claude-haiku-4.5
MODEL_SKILL_ROUTER=claude-haiku-4.5
MODEL_CONVERSATIONAL=claude-haiku-4.5

# Disagreement detector — cross-vendor to avoid self-correlation
MODEL_DISAGREEMENT_DETECTOR=gemini-3.1-pro-preview

# Eval judge — different family from Producer (GPT judges Claude)
MODEL_EVAL_JUDGE=gpt-5.5

# Bullshit filter — structured extraction
MODEL_BULLSHIT_FILTER=gpt-5.5

# Summarizer — cheap long-context
MODEL_SUMMARIZER=gemini-3-flash-preview

# === Sampling defaults (per-call overridable) ===
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=4096

# === Database ===
# Local: postgres in docker-compose
DATABASE_URL=postgresql+asyncpg://plus_one:dev@localhost:5432/plus_one
# Production: Azure Postgres
# DATABASE_URL=postgresql+asyncpg://user:pass@server.postgres.database.azure.com:5432/plus_one?ssl=require

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# Magic-link email (filled in v1.2 when auth ships)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@plusone.app

# === External APIs ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=plus-one/0.1 (by /u/your_username)

GOOGLE_PLACES_API_KEY=

# === Xiaohongshu scraper ===
XHS_COOKIES_FILE=secrets/xhs_cookies.json
XHS_PROXY_URL=

# === Observability ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
