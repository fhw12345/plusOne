# === App ===
APP_ENV=development
LOG_LEVEL=INFO

# === Agent Maestro (LLM gateway, required) ===
# Maestro is an Anthropic-API-compatible gateway proxying Claude / GPT / Gemini.
# All LLM traffic in Plus One goes through it. Token-unlimited internally.
MAESTRO_BASE_URL=http://host.docker.internal:23333/api/anthropic
MAESTRO_AUTH_TOKEN=Powered by Agent Maestro

# === Per-role model overrides (defaults work; override to experiment) ===
# Producer / Joiner — heavy reasoning, Claude Opus 4.7
MODEL_PRODUCER_AGENT=claude-opus-4.7
MODEL_JOINER_AGENT=claude-opus-4.7

# Controller / Skill router / Conversational — cheap + fast, Claude Haiku 4.5
MODEL_CONTROLLER_AGENT=claude-haiku-4.5
MODEL_SKILL_ROUTER=claude-haiku-4.5
MODEL_CONVERSATIONAL=claude-haiku-4.5

# Disagreement detector — cross-vendor to avoid self-correlation
MODEL_DISAGREEMENT_DETECTOR=gemini-3.1-pro-preview

# Eval judge — different family from Producer (GPT judges Claude)
MODEL_EVAL_JUDGE=gpt-5.5

# Bullshit filter — structured extraction
MODEL_BULLSHIT_FILTER=gpt-5.5

# Summarizer — cheap long-context
MODEL_SUMMARIZER=gemini-3-flash-preview

# === Sampling defaults (per-call overridable) ===
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=4096

# === Database ===
# Local: postgres in docker-compose
DATABASE_URL=postgresql+asyncpg://plus_one:dev@localhost:5432/plus_one
# Production: Azure Postgres
# DATABASE_URL=postgresql+asyncpg://user:pass@server.postgres.database.azure.com:5432/plus_one?ssl=require

# Pool sizing
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
# Statement-level kill switch (ms). Cycle-level timeout lives in agent code.
DB_STATEMENT_TIMEOUT_MS=30000

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth ===
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# Magic-link TTL (minutes). 15 is a good balance between user
# convenience and interception risk.
MAGIC_LINK_TTL_MINUTES=15

# Where the frontend lives — used to build the magic-link URL emailed to users.
FRONTEND_BASE_URL=http://localhost:3000

# Email sender opt-in. Leave False to use SMTP. Set True ONLY on a
# developer's local machine — it dumps magic-link URLs into stdout.
ALLOW_CONSOLE_EMAIL_SENDER=false

# Auth cookie. On plain-http localhost, set AUTH_COOKIE_SECURE=false so
# the browser actually keeps the cookie; production should keep it True.
AUTH_COOKIE_NAME=plus_one_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Magic-link email (filled in v1.2 when auth ships)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@plusone.app

# === External APIs ===
# Reddit (ADR-007): unauthenticated JSON endpoint — no credentials needed.
# Set a descriptive User-Agent per Reddit guidance; defaults to
# "plus-one/0.1 (+contact via repo)" if unset.
# REDDIT_USER_AGENT=plus-one/0.1 (+https://github.com/<owner>/plus-one)

# Foursquare Places API (10k calls/month free tier).
FOURSQUARE_API_KEY=

# === GFW / local-dev proxy (local dev only — unset in production) ===
# httpx and most clients honor these automatically. NO_PROXY keeps
# Xiaohongshu and localhost direct while routing reddit.com /
# googleapis.com through your local proxy.
# HTTPS_PROXY=http://127.0.0.1:10809
# HTTP_PROXY=http://127.0.0.1:10809
# NO_PROXY=localhost,127.0.0.1,xiaohongshu.com,xhscdn.com

# === Xiaohongshu scraper ===
XHS_COOKIES_FILE=secrets/xhs_cookies.json
XHS_PROXY_URL=

# === Observability ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
